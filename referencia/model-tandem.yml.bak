#==============================================================================
#  Cenario de validacao: Tandem Q1 -> Q2
#
#  Q1 - G/G/2/3, chegadas 1..4, atendimento 3..4
#  Q2 - G/G/1/5, atendimento 2..3 (sem chegadas externas)
#  Primeira chegada (externa em Q1) em t=1.5
#  100.000 numeros aleatorios como criterio de parada
#==============================================================================
!PARAMETERS

rndnumbersPerSeed: 100000
seeds:
- 7

arrivals:
   Q1: 1.5

queues:
   Q1:
      servers: 2
      capacity: 3
      minArrival: 1.0
      maxArrival: 4.0
      minService: 3.0
      maxService: 4.0
   Q2:
      servers: 1
      capacity: 5
      minService: 2.0
      maxService: 3.0

network:
-  source: Q1
   target: Q2
   probability: 1.0
